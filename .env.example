# Discord Bot Token（從 Discord Developer Portal 取得）
DISCORD_BOT_TOKEN=

# Discord Application Client ID（用於註冊 Slash Commands）
DISCORD_CLIENT_ID=

# Discord 伺服器 ID
DISCORD_GUILD_ID=

# 預設模型（未設定時為 claude-opus-4-6）
DEFAULT_MODEL=claude-opus-4-6

# 預設推理深度（選填，low | medium | high | max，未設定則交由 CLI 預設）
DEFAULT_EFFORT=

# 預設權限模式（default | acceptEdits | bypassPermissions | plan）
# 存取控制改由 Discord 頻道權限把關；bypassPermissions = Bash 等免核可
DEFAULT_PERMISSION_MODE=default
