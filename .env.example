# Discord Bot Token（從 Discord Developer Portal 取得）
DISCORD_BOT_TOKEN=

# Discord Application Client ID（用於註冊 Slash Commands）
DISCORD_CLIENT_ID=

# Discord 伺服器 ID
DISCORD_GUILD_ID=

# 指定頻道 ID（Bot 只在此頻道運作）
DISCORD_CHANNEL_ID=

# 允許操作的使用者 ID（逗號分隔）
ALLOWED_USER_IDS=

# 預設模型
DEFAULT_MODEL=claude-opus-4-6

# 預設工作目錄（選填，fallback 到 projects.json 第一個專案）
DEFAULT_CWD=

# 預設權限模式（default | acceptEdits | bypassPermissions）
DEFAULT_PERMISSION_MODE=default

# Rate Limiting（選填）
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
